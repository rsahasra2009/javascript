<!DOCTYPE html>
<html>

<head>
<title>javascript</title>
</head>

<body>

<script>
function maths() {
   var a = Number(document.getElementById("num2").value)
   var b = Number(document.getElementById("num1").value)
   var result = a * b
    document.getElementById("result").innerHTML= result
}   	
</script>

<input type = "text" id="num1">
<input type = "text" id="num2">
<input type = "button" value="enter" Onclick= "maths()">

<p id="result"></p>


</body>
</html>
